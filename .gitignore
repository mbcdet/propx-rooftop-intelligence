!outputs/_solar_eval/calibration.json
!outputs/_solar_eval/pass2_judgements/
!outputs/_solar_eval/preregistration.md
!outputs/_solar_eval/PHASE3_REPORT.md
!outputs/_solar_eval/build_labels.py
!outputs/_solar_eval/build_reference.py
!outputs/_solar_eval/make_review_sheets.py
!outputs/_solar_eval/score.py
!outputs/_solar_eval/search.py
!outputs/_solar_eval/phase4_verify.py
!outputs/_solar_eval/phase5_score.py
!outputs/_solar_eval/phase4_search.json
!outputs/_solar_eval/phase4_tuned_config.json
!outputs/_solar_eval/phase4_report.json
!outputs/_solar_eval/phase5_report.json

# Regenerated by search.py; 249 KB of intermediate configurations, not evidence.
outputs/_solar_eval/phase4_search_all.json

# Imagery and roof records fetched for the solar-detector evaluation zones. Large, and not
# part of the submission: the committed cache under data/cache/ is the only one the pipeline
# reads. Only labels.csv, the derived bboxes and the eventual results are evidence.
data/eval_cache/

# Reconnaissance artefacts: large mosaics and raw tile caches.
# The chosen study area's minimal cache is committed deliberately in Phase 2.
outputs/recon/

