{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mbcdet/propx-rooftop-intelligence/schema/roof_attributes.schema.json",
  "title": "PropX rooftop attributes",
  "description": "Output contract for outputs/roof_attributes.json (design section 8). The schema is a policy document as much as a validator: it forbids publishing a CV polygon as the primary outline, forbids an attribute without provenance, forbids a confidence without a method, a rationale or the not-calibrated note, and closes every object it safely can so a typo fails the run instead of shipping.",
  "type": "object",
  "required": ["run", "buildings"],
  "additionalProperties": false,
  "properties": {
    "run": { "$ref": "#/$defs/run" },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/building" }
    }
  },
  "$defs": {
    "availability": {
      "description": "Provenance vocabulary from design section 5. Closed: an unrecognised word here is a bug, not a new category.",
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "inferred",
        "authoritative",
        "unavailable",
        "not_in_source"
      ]
    },
    "confidence": {
      "description": "A documented heuristic reliability indicator. score is null when no value was produced. factors carries every multiplicative penalty by name, so the score can be recomputed by hand.",
      "type": "object",
      "required": [
        "score",
        "method",
        "sources",
        "rationale",
        "limitations",
        "factors",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "method": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "factors": {
          "description": "At most three penalties, each in [0.5, 1.0] (design section 6). Enforced here as well as in code, so a hand-edited document cannot smuggle in a fourth.",
          "type": "object",
          "maxProperties": 3,
          "additionalProperties": { "type": "number", "minimum": 0.5, "maximum": 1.0 }
        },
        "note": {
          "description": "Emitted by types.Confidence.as_dict. const, so no document can be published without it.",
          "const": "Documented heuristic reliability indicator, not a calibrated probability."
        }
      }
    },
    "conflict": {
      "description": "Authoritative value versus image evidence (design section 5.1). Records the disagreement; never a correction.",
      "type": "object",
      "required": ["flag", "status", "description"],
      "additionalProperties": false,
      "properties": {
        "flag": { "type": "boolean" },
        "status": { "const": "requires_visual_review" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "image_evidence": {
      "description": "An independent image observation, reported alongside an authoritative value rather than replacing it.",
      "type": "object",
      "required": ["indicates", "method", "rationale"],
      "additionalProperties": false,
      "properties": {
        "indicates": true,
        "method": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "quality": { "type": "object" }
      }
    },
    "attribute": {
      "description": "One published attribute. value may be any JSON type including null; a null value is only legal with availability unavailable or not_in_source, which types.Attribute enforces at construction.",
      "type": "object",
      "required": ["value", "availability", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": true,
        "availability": { "$ref": "#/$defs/availability" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "unit": { "type": ["string", "null"] },
        "measure": {
          "description": "e.g. \"planimetric\" — stated in-record so an area is never read as a roof-surface area.",
          "type": ["string", "null"]
        },
        "source_detail": {
          "description": "Layer, field and raw source value. Left open: source field names are preserved verbatim and vary by layer.",
          "type": "object"
        },
        "image_evidence": { "$ref": "#/$defs/image_evidence" },
        "conflict": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/conflict" }]
        }
      }
    },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array" },
        "crs": { "type": "string" },
        "bbox": { "type": "array", "items": { "type": "number" } },
        "polygon_source": { "type": "string", "minLength": 1 }
      }
    },
    "authoritative_polygon": {
      "description": "The primary outline. polygon_source is required because a reader must be able to tell the 2025 roof record from the FMZK fallback dissolve (design section 3.2).",
      "allOf": [
        { "$ref": "#/$defs/polygon" },
        { "type": "object", "required": ["polygon_source"] }
      ]
    },
    "agreement": {
      "description": "Agreement between two related estimates, not segmentation accuracy: the CV polygon is seeded from the authoritative outline (design section 4.1).",
      "type": "object",
      "required": [
        "iou",
        "symmetric_difference_ratio",
        "hausdorff_m",
        "boundary_gradient_ratio"
      ],
      "additionalProperties": false,
      "properties": {
        "iou": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "symmetric_difference_ratio": { "type": ["number", "null"], "minimum": 0 },
        "hausdorff_m": { "type": ["number", "null"], "minimum": 0 },
        "boundary_gradient_ratio": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "delineation": {
      "description": "Who delineated what. primary_polygon is a const, so the schema itself forbids publishing a CV polygon as the primary outline (design section 4).",
      "type": "object",
      "required": [
        "primary_polygon",
        "segmenter",
        "agreement_with_authoritative_geometry",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "primary_polygon": { "const": "authoritative_roof_polygon" },
        "segmenter": { "type": "string", "minLength": 1 },
        "agreement_with_authoritative_geometry": { "$ref": "#/$defs/agreement" },
        "boundary_alignment_warning": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["flag"],
              "additionalProperties": false,
              "properties": {
                "flag": { "type": "boolean" },
                "status": {
                  "description": "Present only when flag is true. Same requires_visual_review marker used by an attribute conflict, so both routes to human inspection read alike. When this fires, the record's top-level review_flags array also carries a boundary_alignment_warning entry, so review_flags is the single complete answer to 'what needs a human?'.",
                  "enum": ["requires_visual_review"]
                },
                "metrics": { "type": ["object", "null"] },
                "note": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "failure_reason": {
          "description": "Segmentation not converging is a reportable outcome, not an error.",
          "type": ["string", "null"]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "fmzk_crosscheck": {
      "description": "Cross-check only (design section 1.4). matched_by is a const: boundary identity was tested on real geometry and rejected, so best geometric overlap is the only join rule the output can express.",
      "type": "object",
      "required": [
        "matched_by",
        "cardinality",
        "cardinality_basis",
        "iou",
        "containment_roof_in_unit",
        "containment_unit_in_roof",
        "second_best_iou",
        "ambiguous"
      ],
      "additionalProperties": false,
      "properties": {
        "matched_by": { "const": "best_geometric_overlap" },
        "cardinality": {
          "description": "Read in the direction given by cardinality_basis: BW_GEB_ID building unit -> authoritative roof records. 1:1 = one unit, one roof record. 1:n = one unit carrying several roof records (the documented Seestadt cases 5729190 -> 4 and 5576077 -> 2); every competing record id is listed in competing_roof_record_ids and none is averaged or chosen. unmatched = no unit overlapped the roof record. 'n:1' is intentionally not a permitted value, because reversing the orientation silently inverts the meaning of the join.",
          "enum": ["1:1", "1:n", "unmatched"]
        },
        "cardinality_basis": {
          "description": "Fixed orientation for every cardinality value in this document, published so the notation cannot be misread.",
          "const": "building_unit_to_roof_records"
        },
        "bw_geb_id": { "type": ["integer", "null"] },
        "iou": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "containment_roof_in_unit": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "containment_unit_in_roof": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "second_best_iou": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "second_best_bw_geb_id": { "type": ["integer", "null"] },
        "ambiguous": { "type": "boolean" },
        "ambiguity_reasons": { "type": "array", "items": { "type": "string" } },
        "fmzk_parts_in_unit": { "type": "integer", "minimum": 0 },
        "fmzk_parts_null_id_in_area": { "type": "integer", "minimum": 0 },
        "fmzk_fetch_buffer_m": { "type": "number", "minimum": 0 },
        "unit_touches_fetch_boundary": { "type": "boolean" },
        "competing_roof_record_ids": { "type": "array", "items": { "type": "integer" } },
        "aggregation": {
          "description": "applied stays false unless an explicit, reasoned aggregation was configured; 1:n joins are never silently averaged (design section 1.4 rule 5).",
          "type": "object",
          "required": ["applied"],
          "additionalProperties": false,
          "properties": {
            "applied": { "type": "boolean" },
            "n_records": { "type": ["integer", "null"] },
            "method": { "type": ["string", "null"] },
            "reason": { "type": ["string", "null"] }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "review_flag": {
      "type": "object",
      "required": ["status", "trigger", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "requires_visual_review" },
        "trigger": {
          "enum": [
            "authoritative_image_conflict",
            "slope_mean_above_review_threshold",
            "ambiguous_join",
            "boundary_alignment_warning"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 }
      }
    },
    "attributes": {
      "description": "Closed vocabulary from the design section 5 table. A misspelled attribute name fails the run rather than appearing as a new field nobody documented. roof_area_m2, roof_type and mean_slope_deg are always emitted — absent source data becomes availability not_in_source, never a missing key.",
      "type": "object",
      "required": ["roof_area_m2", "roof_type", "mean_slope_deg"],
      "additionalProperties": false,
      "properties": {
        "roof_area_m2": { "$ref": "#/$defs/attribute" },
        "roof_type": { "$ref": "#/$defs/attribute" },
        "roof_subtype": { "$ref": "#/$defs/attribute" },
        "roof_surface_class": { "$ref": "#/$defs/attribute" },
        "ridge_orientation_deg": { "$ref": "#/$defs/attribute" },
        "footprint_axis_orientation_deg": { "$ref": "#/$defs/attribute" },
        "mean_slope_deg": { "$ref": "#/$defs/attribute" },
        "pv_potential_kwp": { "$ref": "#/$defs/attribute" },
        "pv_potential_annual_yield_kwh": { "$ref": "#/$defs/attribute" },
        "pv_suitability_area_m2": { "$ref": "#/$defs/attribute" },
        "solar_panels": {
          "description": "WITHHELD PENDING VALIDATION. The RGB detector was spot-checked against the imagery and found anti-correlated on all four checkable cases, so no Boolean is published: value is always null, availability is 'unavailable' and confidence.score is always null. The detector's raw candidate diagnostics are retained under image_evidence.quality, labelled unvalidated candidate evidence, for a future labelled validation. Thresholds were deliberately NOT adjusted to fit the selected sample.",
          "allOf": [
            { "$ref": "#/$defs/attribute" },
            {
              "type": "object",
              "properties": {
                "value": { "type": "null" },
                "availability": { "const": "unavailable" },
                "confidence": {
                  "type": "object",
                  "properties": { "score": { "type": "null" } }
                }
              }
            }
          ]
        },
        "green_roof": { "$ref": "#/$defs/attribute" },
        "construction_epoch": { "$ref": "#/$defs/attribute" },
        "building_typology": { "$ref": "#/$defs/attribute" },
        "year_built": { "$ref": "#/$defs/attribute" },
        "architect": { "$ref": "#/$defs/attribute" },
        "address": { "$ref": "#/$defs/attribute" }
      }
    },
    "building": {
      "type": "object",
      "required": [
        "building_id",
        "source_ids",
        "authoritative_roof_polygon",
        "cv_candidate_polygon",
        "delineation",
        "fmzk_crosscheck",
        "attributes",
        "review_flags"
      ],
      "additionalProperties": false,
      "properties": {
        "building_id": { "type": "string", "pattern": "^vie-[A-Za-z]+-[0-9]{3}$" },
        "source_ids": {
          "type": "object",
          "required": ["anlagenleistung2025_objectid", "bw_geb_id"],
          "additionalProperties": false,
          "properties": {
            "anlagenleistung2025_objectid": { "type": ["integer", "null"] },
            "bw_geb_id": { "type": ["integer", "null"] },
            "fmzk_ids": { "type": "array", "items": { "type": "integer" } }
          }
        },
        "authoritative_roof_polygon": { "$ref": "#/$defs/authoritative_polygon" },
        "cv_candidate_polygon": {
          "description": "null on segmentation failure, which is a reportable outcome and not an error.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/polygon" }]
        },
        "delineation": { "$ref": "#/$defs/delineation" },
        "fmzk_crosscheck": { "$ref": "#/$defs/fmzk_crosscheck" },
        "attributes": { "$ref": "#/$defs/attributes" },
        "review_flags": { "type": "array", "items": { "$ref": "#/$defs/review_flag" } },
        "address": { "type": ["string", "null"] },
        "overlay": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "licence", "attribution", "accessed"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "licence": { "const": "CC BY 4.0" },
        "attribution": { "const": "Datenquelle: Stadt Wien - data.wien.gv.at" },
        "accessed": { "type": "string", "minLength": 1 },
        "layer": { "type": "string" },
        "role": { "type": "string" },
        "year": { "type": "integer" },
        "resolution_m": { "type": "number", "exclusiveMinimum": 0 },
        "model_basis": { "type": "string" },
        "flight_dates": { "type": "array", "items": { "type": "string" } },
        "feature_count_citywide": { "type": "integer", "minimum": 0 }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "generated_at",
        "pipeline_version",
        "config_hash",
        "study_area",
        "sources",
        "confidence_note",
        "sample_note",
        "manual_review"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "minLength": 1 },
        "pipeline_version": { "type": "string", "minLength": 1 },
        "config_hash": { "type": "string", "minLength": 1 },
        "study_area": {
          "type": "object",
          "required": ["name", "bbox_wgs84", "crs_metric", "imagery_zoom"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "bbox_wgs84": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number" }
            },
            "crs_metric": {
              "description": "Every published metric value comes from this projected CRS (Amendment B3). Web Mercator area error at Vienna's latitude is ~2.2x, so EPSG:3857 is not permitted here.",
              "const": "EPSG:31256"
            },
            "imagery_zoom": { "type": "integer", "minimum": 0, "maximum": 21 }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "confidence_note": {
          "const": "Heuristic reliability indicators, not calibrated probabilities. Not validated against labelled ground truth."
        },
        "sample_note": {
          "const": "The 8–10 buildings form a purposive sample selected for attribute diversity, source availability, and visual interpretability. They are not statistically representative of Vienna's building stock."
        },
        "manual_review": {
          "description": "QA only. Review cannot mutate, promote or override any pipeline output (design section 7); this block reports whether anyone has looked.",
          "type": "object",
          "required": ["status", "reviewer", "n"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["not_yet_reviewed", "reviewed"] },
            "reviewer": { "type": ["string", "null"] },
            "n": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    }
  }
}
